WEB_USERNAME=admin
WEB_PASSWORD=replace-with-a-long-random-password
CLOUD_BACKEND=mock
# App credentials are loaded separately from ../.env by Docker Compose.
# For real devices: CLOUD_BACKEND=ewelink, SENSOR_BACKEND=gpio
# Leave SENSOR_BACKEND unset for simulation.
DOMAIN=sonoff.example.com
ACME_EMAIL=you@example.com
EWL_REDIRECT_URL=https://sonoff.example.com/oauth/callback
# GPIO_GID=997
# GPIO_DEVICE=/dev/gpiochip0

# Optional Telegram notifications. Start the bot or add it to the target chat first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
